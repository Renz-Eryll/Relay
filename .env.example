# Neon Postgres. `vercel env pull .env.local` fills these from the Vercel project.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Lets Vercel Cron call /api/cron/reset-demo to restore the demo workspace daily
CRON_SECRET=

# Optional SMTP for password reset codes (without it, codes are logged to the server console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Relay <you@example.com>"

# Relay AI (optional). A free key from https://aistudio.google.com (Get API key, no card needed).
# Without it, Relay runs exactly as before and the AI features are hidden.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.5-flash), or set AI_ENABLED=false to switch AI off
AI_MODEL=
AI_ENABLED=
