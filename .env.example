# Neon Postgres. `vercel env pull .env.local` fills these from the Vercel project.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Lets Vercel Cron call /api/cron/reset-demo to restore the demo workspace daily
CRON_SECRET=

# Optional SMTP for password reset codes (without it, codes are logged to the server console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Relay <you@example.com>"
